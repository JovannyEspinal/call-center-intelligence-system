# Analysis backend: mock or openai.
ANALYSIS_BACKEND=mock

# OpenAI provider settings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
OPENAI_DIARIZED_CHUNK_SECONDS=180

# Optional LangSmith tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=call-center-intelligence-system

# Local persistence.
DATABASE_URL=sqlite:///data/calls.db

# Audio processing limits.
MAX_AUDIO_SIZE_MB=50
MAX_AUDIO_DURATION_MINUTES=60

# Transcription backend: mock, faster_whisper, or openai_diarized.
TRANSCRIPTION_BACKEND=mock
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# Gradio server settings.
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
